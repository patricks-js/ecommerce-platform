{
  "name": "@sales/api",
  "version": "1.0.0",
  "description": "Simplified marketplace API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsup src",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:prod": "node dist/core/db/migrate.js || true && node dist/server.js",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/core/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "commit": "cz",
    "git:prepare": "lefthook install"
  },
  "dependencies": {
    "@fakerjs/faker": "3.0.0",
    "@fastify/cors": "10.0.1",
    "@fastify/jwt": "9.0.1",
    "@fastify/swagger": "9.2.0",
    "@paralleldrive/cuid2": "2.2.2",
    "@scalar/fastify-api-reference": "1.25.56",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.26.2",
    "drizzle-orm": "0.35.2",
    "drizzle-zod": "0.5.1",
    "fastify": "5.0.0",
    "fastify-plugin": "5.0.1",
    "pino-pretty": "11.3.0",
    "postgres": "3.4.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.7.5",
    "@vitest/coverage-istanbul": "2.1.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "lefthook": "1.7.18",
    "tsup": "8.3.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vite-tsconfig-paths": "5.0.1",
    "vitest": "2.1.3"
  },
  "packageManager": "pnpm@9.11.0"
}
